rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helpers
    function validPhone(p) {
      // Phone is optional — allow empty or up to 25 chars.
      return p is string && p.size() <= 25;
    }
    function validName(n) {
      return n is string && n.size() > 0 && n.size() <= 80;
    }
    function validPinHash(h) {
      // PBKDF2 SHA-256 hex = 64 chars; keep room for versioning.
      return h is string && h.size() >= 32 && h.size() <= 128;
    }
    function validType(t) {
      return t in ['Oral Surgery/Urg Care','Oral Surgery','Urgent Care','Ortho','Special Care','Peds','Emergency','On-Call','Screening','Hospital','Pan','Mock Boards','Education/Other','Perio','Clerkship','Shady Grove'];
    }
    function validTime(t) {
      return t == 'morning' || t == 'afternoon';
    }
    function validDate(d) {
      return d is string && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // User profiles, one doc per S#.
    match /users/{sNumber} {
      allow read: if request.auth != null;

      allow create: if sNumber.matches('^S[0-9]{5}$')
        && request.resource.data.keys().hasAll(['sNumber','name','phone','pinHash','createdAt','updatedAt'])
        && request.resource.data.sNumber == sNumber
        && validName(request.resource.data.name)
        && validPhone(request.resource.data.phone)
        && validPinHash(request.resource.data.pinHash)
        && request.resource.data.createdAt is number
        && request.resource.data.updatedAt is number;

      allow update: if sNumber.matches('^S[0-9]{5}$')
        && request.resource.data.sNumber == resource.data.sNumber
        && request.resource.data.pinHash == resource.data.pinHash
        && request.resource.data.createdAt == resource.data.createdAt
        && validName(request.resource.data.name)
        && validPhone(request.resource.data.phone)
        && request.resource.data.updatedAt is number;

      allow delete: if false;
    }

    // Posted blocks.
    match /blocks/{blockId} {
      allow read: if request.auth != null;

      allow create: if request.resource.data.keys().hasAll(
          ['date','time','type','name','sNumber','phone','createdAt']
        )
        && request.resource.data.sNumber is string
        && request.resource.data.sNumber.matches('^S[0-9]{5}$')
        && validDate(request.resource.data.date)
        && validTime(request.resource.data.time)
        && validType(request.resource.data.type)
        && validName(request.resource.data.name)
        && validPhone(request.resource.data.phone)
        && request.resource.data.createdAt is number
        && (request.resource.data.notes == null
            || (request.resource.data.notes is string
                && request.resource.data.notes.size() <= 200));

      allow update: if request.resource.data.sNumber == resource.data.sNumber
        && request.resource.data.createdAt == resource.data.createdAt
        && validDate(request.resource.data.date)
        && validTime(request.resource.data.time)
        && validType(request.resource.data.type)
        && validName(request.resource.data.name)
        && validPhone(request.resource.data.phone)
        && (request.resource.data.notes == null
            || (request.resource.data.notes is string
                && request.resource.data.notes.size() <= 200));

      allow delete: if true;
    }

    // Assist requests.
    match /assists/{assistId} {
      allow read: if request.auth != null;

      allow create: if request.resource.data.keys().hasAll(
          ['sNumber','name','phone','date','time','procedure','chair','notes','createdAt']
        )
        && request.resource.data.sNumber is string
        && request.resource.data.sNumber.matches('^S[0-9]{5}$')
        && validDate(request.resource.data.date)
        && request.resource.data.time in ['7am','9:30am','1pm','2pm','4pm']
        && request.resource.data.procedure in ['Endo','Fixed','Remo','Operative']
        && validName(request.resource.data.name)
        && validPhone(request.resource.data.phone)
        && (request.resource.data.chair == null
            || (request.resource.data.chair is string
                && request.resource.data.chair.size() <= 10))
        && (request.resource.data.notes == null
            || (request.resource.data.notes is string
                && request.resource.data.notes.size() <= 200))
        && request.resource.data.createdAt is number;

      allow update: if request.resource.data.sNumber == resource.data.sNumber
        && request.resource.data.date == resource.data.date
        && request.resource.data.time == resource.data.time
        && request.resource.data.procedure == resource.data.procedure
        && request.resource.data.createdAt == resource.data.createdAt
        && validName(request.resource.data.name)
        && validPhone(request.resource.data.phone);

      allow delete: if true;
    }

    // Session records for the admin usage view.
    match /sessions/{sessionId} {
      allow read: if request.auth != null;
      allow create: if request.resource.data.keys().hasAll(['sNumber','startedAt','lastActive'])
        && request.resource.data.sNumber is string
        && request.resource.data.sNumber.matches('^S[0-9]{5}$')
        && request.resource.data.startedAt is number
        && request.resource.data.lastActive is number;
      allow update: if request.resource.data.sNumber == resource.data.sNumber
        && request.resource.data.startedAt == resource.data.startedAt
        && request.resource.data.lastActive is number;
      allow delete: if false;
    }

    // Private site configuration (admin hash).
    match /config/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Client-side error reports.
    match /clientErrors/{errorId} {
      allow read, update, delete: if false;
      allow create: if request.resource.data.keys().hasAll(
          ['context','message','code','sNumber','userAgent','url','timestamp']
        )
        && request.resource.data.context is string
        && request.resource.data.context.size() <= 60
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 500
        && request.resource.data.code is string
        && request.resource.data.code.size() <= 60
        && request.resource.data.sNumber is string
        && request.resource.data.sNumber.size() <= 6
        && request.resource.data.userAgent is string
        && request.resource.data.userAgent.size() <= 300
        && request.resource.data.url is string
        && request.resource.data.url.size() <= 200
        && request.resource.data.timestamp is number;
    }

    // BEGIN BASER ANALYTICS — deploy with tools/analytics-rules.mjs.
    // Anonymous usage only: this schema cannot contain models, filenames,
    // label text, contact information, or ScheduleMaxer profile identifiers.
    match /baserUsageSessions/{sessionId} {
      function analyticsOwner() {
        return request.auth != null
          && request.auth.token.firebase.sign_in_provider in ['google.com', 'password']
          && request.auth.token.email == 'maxethis@gmail.com'
          && request.auth.token.email_verified == true;
      }
      function anonymousVisitor() {
        return request.auth != null
          && request.auth.token.firebase.sign_in_provider == 'anonymous'
          && request.resource.data.visitorId == request.auth.uid;
      }
      function counter(value) {
        return value is int && value >= 0 && value <= 10000;
      }
      function counterChange(before, after) {
        return after >= before && after <= before + 100;
      }
      function validSession() {
        let d = request.resource.data;
        return sessionId.matches('^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$')
          && d.keys().hasAll(['schemaVersion','visitorId','startedAt','lastActiveAt','activeSeconds','import_success','import_error','export_started','export_success','export_error','text_applied','pattern_changed'])
          && d.keys().hasOnly(['schemaVersion','visitorId','startedAt','lastActiveAt','activeSeconds','import_success','import_error','export_started','export_success','export_error','text_applied','pattern_changed'])
          && d.schemaVersion == 1
          && d.visitorId is string && d.visitorId.size() >= 1 && d.visitorId.size() <= 128
          && d.startedAt is timestamp && d.lastActiveAt == request.time
          && d.startedAt <= d.lastActiveAt
          && d.activeSeconds is int && d.activeSeconds >= 0 && d.activeSeconds <= 86400
          && counter(d.import_success)
          && counter(d.import_error)
          && counter(d.export_started)
          && counter(d.export_success)
          && counter(d.export_error)
          && counter(d.text_applied)
          && counter(d.pattern_changed);
      }
      allow read: if analyticsOwner();
      allow create: if anonymousVisitor() && validSession()
        && request.resource.data.startedAt == request.time
        && request.resource.data.activeSeconds <= 120
        && request.resource.data.import_success <= 100
        && request.resource.data.import_error <= 100
        && request.resource.data.export_started <= 100
        && request.resource.data.export_success <= 100
        && request.resource.data.export_error <= 100
        && request.resource.data.text_applied <= 100
        && request.resource.data.pattern_changed <= 100;
      allow update: if anonymousVisitor() && validSession()
        && request.resource.data.visitorId == resource.data.visitorId
        && request.resource.data.startedAt == resource.data.startedAt
        && request.resource.data.activeSeconds >= resource.data.activeSeconds
        && request.resource.data.activeSeconds <= resource.data.activeSeconds + 120
        && counterChange(resource.data.import_success, request.resource.data.import_success)
        && counterChange(resource.data.import_error, request.resource.data.import_error)
        && counterChange(resource.data.export_started, request.resource.data.export_started)
        && counterChange(resource.data.export_success, request.resource.data.export_success)
        && counterChange(resource.data.export_error, request.resource.data.export_error)
        && counterChange(resource.data.text_applied, request.resource.data.text_applied)
        && counterChange(resource.data.pattern_changed, request.resource.data.pattern_changed);
      allow delete: if false;
    }
    // END BASER ANALYTICS
  }
}
